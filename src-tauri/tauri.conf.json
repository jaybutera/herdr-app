{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Orcha",
  "version": "0.1.4",
  "identifier": "dev.herdr.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Orcha",
        "width": 420,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0B0E13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
